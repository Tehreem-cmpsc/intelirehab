{
  // Run / F5 in VS Code.
  "version": "0.2.0",
  "configurations": [
    {
      // The app always talks to the real Supabase project (see
      // lib/core/network/supabase_client.dart). Needs the supabase_patient_*.sql
      // files in Intelli_Rehab_Web_Portal/scripts run first (see the app README).
      // To use another project, add:
      //   "args": ["--dart-define=SUPABASE_URL=...", "--dart-define=SUPABASE_PUBLISHABLE_KEY=..."]
      "name": "Mobile app",
      "type": "dart",
      "request": "launch",
      "cwd": "Inteli_Rehab_Mobile_App",
      "program": "lib/main.dart"
    }
  ]
}
