# Copy to .env (never commit it). Both values are public by design - the
# publishable key is safe in the browser because access is enforced by RLS.
# NEVER put a service_role / secret key in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
