@startuml Intelli_Rehab_ERD
' ---------------------------------------------------------------------------
' Inteli Rehab - database ERD, written from the Supabase migrations in
' Intelli_Rehab_Web_Portal/supabase_*.sql (every column added by later ALTERs
' is included) and from what the mobile app and portal read and write.
'
' Reading guide
'   * marks NOT NULL.  PK = primary key, FK = foreign key, UQ = unique.
'   Each table lists its keys first, then its data, then status / timestamps.
'   A nullable foreign key is drawn as "zero or one" on the parent side.
' ---------------------------------------------------------------------------
hide circle
skinparam linetype ortho
skinparam roundcorner 6
skinparam shadowing false
skinparam defaultFontSize 12
skinparam entity {
  BackgroundColor #F5F8F7
  BorderColor #0D6E76
}
skinparam package {
  BorderColor #0D6E76
  FontColor #073C41
  BackgroundColor #FFFFFF
}
skinparam note {
  BackgroundColor #FFF6E5
  BorderColor #E7A24C
}
skinparam ArrowColor #073C41

' ============================ 1. clinic and staff ============================
package "1. Clinic and staff" {

  entity "auth.users" as auth_users <<Supabase Auth>> {
    * id : uuid <<PK>>
    --
    email, password, metadata
  }

  entity "clinics" as clinics {
    * id : uuid <<PK>>
    admin_user_id : uuid <<FK auth.users>>
    --
    * name : text
    * email : text <<UQ>>
    phone : text
    address : text
    logo_url : text
    --
    * created_at : timestamptz
  }

  entity "physiotherapists" as physiotherapists {
    * id : uuid <<PK>>
    * clinic_id : uuid <<FK>>
    * user_id : uuid <<FK auth.users>>
    --
    * physio_code : text <<UQ>>
    full_name : text
    specialization : text
    license_number : text
    cnic : text
    qualification : text
    years_experience : integer
    joining_date : date
    --
    * status : text  (default 'Active')
    * must_reset_password : boolean
    * created_at : timestamptz
  }

  entity "activity_log" as activity_log {
    * id : uuid <<PK>>
    * clinic_id : uuid <<FK>>
    --
    * message : text
    * created_at : timestamptz
  }

  entity "physio_auth_attempts" as physio_auth_attempts {
    * physio_code : text
    * attempted_at : timestamptz
    --
    login throttle log (Edge Function only)
  }
}

' ================================= 2. patient ================================
package "2. Patient and band" {

  entity "patients" as patients {
    * id : uuid <<PK>>
    clinic_id : uuid <<FK>>
    physio_id : uuid <<FK>>
    user_id : uuid <<FK auth.users>>
    --
    reg_id : text <<UQ>>
    * name : text
    full_name : text  (older column)
    * email : text
    * phone : text
    * date_of_birth : date
    * gender : text
    height_cm : numeric
    weight_kg : numeric
    activity_level : text  (sedentary | light | active | very_active)
    dominant_arm : text  (left | right | both)
    --
    * injury_side : text
    injury : text
    injury_severity : text
    diagnosis_date : date
    recovery_stage : text
    risk_level : text
    notes : text
    warning : text
    --
    * approved : boolean  (physio approval)
    * status : text  (default 'active')
    * wearable_connected : boolean  (kept by a trigger)
    terms_accepted_at : timestamptz
    * created_at : timestamptz
  }

  entity "patient_injuries" as patient_injuries {
    * id : uuid <<PK>>
    * patient_id : uuid <<FK>>
    --
    * affected_side : text  (left | right)
    * affected_joint : text  (upper_arm | elbow | forearm | shoulder | wrist | multiple)
    injury_type : text
    cause : text  (sports | fall | accident | overuse | surgery | other)
    first_injury : boolean
    pain_level : smallint  (0 to 3)
    diagnosis_date : date
    description : text
    --
    * source : text  (default 'patient_self_report')
    * created_at : timestamptz
  }

  entity "wearable_devices" as wearable_devices {
    * id : uuid <<PK>>
    * patient_id : uuid <<FK>>
    --
    serial_no : text  (the band's Bluetooth id)
    mac_address : text
    firmware_version : text
    --
    * status : text  (paired | replaced)
    * is_connected : boolean  (live presence)
    last_seen_at : timestamptz
    * created_at : timestamptz
  }
}

' ============================== 3. exercise plan =============================
package "3. Exercises and plans" {

  entity "exercises" as exercises {
    * id : uuid <<PK>>
    --
    * name : text
    target : text
    * difficulty : text  (Beginner | Intermediate | Advanced)
    description : text
    media_url : text  (exercises/slug.webp or an https URL)
    * media_type : text  (image | video)
    --
    * created_at : timestamptz
  }

  entity "rehabilitation_plans" as rehabilitation_plans {
    * id : uuid <<PK>>
    * patient_id : uuid <<FK>>
    physio_id : uuid <<FK>>
    --
    plan_name : text
    start_date : date
    end_date : date
    --
    * status : text  (default 'active')
    * version_no : integer
  }

  entity "patient_exercise_plans" as patient_exercise_plans {
    * id : uuid <<PK>>
    * patient_id : uuid <<FK>>
    * exercise_id : uuid <<FK>>
    assigned_by : uuid <<FK physiotherapists>>
    plan_id : uuid <<FK>>
    --
    * sets : integer  (default 3)
    * reps : integer  (default 10)
    rom_target : integer  (percent of full range)
    frequency : text
    --
    * active : boolean
    * created_at : timestamptz
  }
}

' ============================ 4. sessions and data ===========================
package "4. Sessions and recorded data" {

  entity "sessions" as sessions {
    * id : uuid <<PK>>
    * patient_id : uuid <<FK>>
    exercise_id : uuid <<FK>>  (null for the sign-up baseline)
    device_id : uuid <<FK wearable_devices>>
    --
    rom : integer  (percent; baseline: degrees)
    reps : integer
    quality : integer
    fatigue : integer
    duration_seconds : integer
    --
    * performed_at : timestamptz
    * created_at : timestamptz
  }

  entity "movement_analysis" as movement_analysis {
    * id : uuid <<PK>>
    * session_id : uuid <<FK>>
    --
    joint_angle : real  (peak; baseline: furthest reach)
    rom : real  (range in degrees)
    repetition_count : integer
    movement_score : real
    muscle_activation : text  (resting | light | moderate | high)
    fatigue_level : text
    posture_status : text  (baseline marker: baseline_calibration)
    * compensation_detected : boolean
    --
    * analyzed_at : timestamptz
  }

  entity "alerts" as alerts {
    * id : uuid <<PK>>
    session_id : uuid <<FK>>
    analysis_id : uuid <<FK movement_analysis>>
    acknowledged_by : uuid <<FK physiotherapists>>
    --
    * alert_type : text  (unsafe_movement | correction)
    * severity : text  (critical | warning)
    message : text
    --
    * created_at : timestamptz
    acknowledged_at : timestamptz
  }

  entity "emg_readings" as emg_readings {
    * id : uuid <<PK>>
    * session_id : uuid <<FK>>
    --
    * muscle : text
    * value : integer
    * recorded_at : timestamptz
  }

  entity "sensor_readings" as sensor_readings {
    * id : uuid <<PK>>
    * session_id : uuid <<FK>>
    --
    imu_acc_x, imu_acc_y, imu_acc_z : real
    gyro_x, gyro_y, gyro_z : real
    --
    * recorded_at : timestamptz
  }
}

' ============================== 5. gamification ==============================
package "5. Badges" {

  entity "badges" as badges {
    * id : uuid <<PK>>
    --
    * code : text
    * name : text
    description : text
    icon_url : text
  }

  entity "patient_badges" as patient_badges {
    * id : uuid <<PK>>
    * patient_id : uuid <<FK>>
    * badge_id : uuid <<FK>>
    --
    * earned_at : timestamptz
  }
}

' ============================== relationships ================================
' --- clinic and staff
clinics ||--o{ physiotherapists
clinics ||--o{ activity_log
auth_users |o--o{ clinics : admin_user_id
auth_users ||--o{ physiotherapists : user_id
physiotherapists .. physio_auth_attempts : physio_code

' --- patient and band
clinics |o--o{ patients : clinic_id
physiotherapists |o--o{ patients : physio_id
auth_users |o--o{ patients : user_id
patients ||--o{ patient_injuries
patients ||--o{ wearable_devices

' --- exercises and plans
patients ||--o{ rehabilitation_plans
physiotherapists |o--o{ rehabilitation_plans : physio_id
patients ||--o{ patient_exercise_plans
exercises ||--o{ patient_exercise_plans
physiotherapists |o--o{ patient_exercise_plans : assigned_by
rehabilitation_plans |o--o{ patient_exercise_plans : plan_id

' --- sessions and data
patients ||--o{ sessions
exercises |o--o{ sessions : exercise_id
wearable_devices |o--o{ sessions : device_id
sessions ||--o{ movement_analysis
sessions ||--o{ emg_readings
sessions ||--o{ sensor_readings
sessions |o--o{ alerts
movement_analysis |o--o{ alerts : analysis_id
physiotherapists |o--o{ alerts : acknowledged_by

' --- badges
patients ||--o{ patient_badges
badges ||--o{ patient_badges

' ================================== notes ====================================
note bottom of clinics
  On delete: rows owned by a parent are removed with it (cascade):
  clinic to staff, patients and log; patient to injuries, bands, plans,
  sessions and badges; session to its analysis, readings and alerts.
  Optional links are set to null instead (for example a patient's
  physiotherapist). An exercise cannot be deleted while a plan uses it.
end note

note right of sessions
  Two kinds of row:
  - an exercise session (exercise_id set), saved by the mobile app
    after each session, uploaded idempotently with client-made ids;
  - the sign-up calibration baseline (exercise_id null), which has a
    movement_analysis row with posture_status = baseline_calibration.
end note

note bottom of emg_readings
  emg_readings, sensor_readings and the badge tables exist in the schema
  but the mobile app does not write to them yet.
end note

note bottom of patients
  Row Level Security is on for every table. Patients see and add only
  their own rows; physios and clinic admins see their clinic's patients.
  Helpers: is_own_patient, is_physio_of_patient, is_admin_of_patient.
end note
@enduml
