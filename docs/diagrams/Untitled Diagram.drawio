        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\nskinparam componentStyle rectangle\nskinparam shadowing false\n\npackage \&quot;Wearable Device\&quot; {\n\ncomponent \&quot;Li-Po Battery\&quot; as Battery\n\ncomponent \&quot;Power Circuit\&quot; as Power\n\ncomponent \&quot;IMU\\n(6-Axis)\&quot; as IMU\n\ncomponent \&quot;Surface EMG\&quot; as EMG\n\ncomponent \&quot;ESP32\\nBLE Controller\&quot; as ESP\n\nBattery --&gt; Power\nPower --&gt; ESP\nPower --&gt; IMU\nPower --&gt; EMG\n\nIMU --&gt; ESP : IMU Data\nEMG --&gt; ESP : EMG Signal\n\n}\n\npackage \&quot;Mobile Application\&quot;{\n\ncomponent \&quot;Bluetooth Manager\&quot; as BLE\n\ncomponent \&quot;Calibration Module\&quot; as Cal\n\ncomponent \&quot;Exercise Session\&quot; as Session\n\ncomponent \&quot;Digital Twin\&quot; as Twin\n\ncomponent \&quot;Feedback Module\&quot; as Feed\n\n}\n\npackage \&quot;Cloud Services\&quot;{\n\ncomponent \&quot;Firebase / Database\&quot; as DB\n\ncomponent \&quot;AI Movement Analysis\&quot; as AI\n\ncomponent \&quot;Progress Analytics\&quot; as Progress\n\n}\n\npackage \&quot;Physiotherapist Portal\&quot;{\n\ncomponent \&quot;Dashboard\&quot; as Dash\n\ncomponent \&quot;Exercise Management\&quot; as Exercise\n\ncomponent \&quot;Patient Monitoring\&quot; as Monitor\n\n}\n\nESP --&gt; BLE : BLE\n\nBLE --&gt; Cal\nCal --&gt; Session\n\nSession --&gt; Twin\n\nSession --&gt; DB\n\nDB --&gt; AI\n\nAI --&gt; Feed\n\nFeed --&gt; Session\n\nDB --&gt; Progress\n\nProgress --&gt; Dash\n\nDash --&gt; Exercise\n\nExercise --&gt; DB\n\nDash --&gt; Monitor\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2nypT-pmQ9iRR-B5uTjJ-67">
