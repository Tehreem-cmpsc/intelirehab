@startuml class_diagram_web
title Class diagram: Web portal (React) - main classes
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 45
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #555555
  AttributeFontSize 12
}
skinparam title {
  FontSize 16
}

' ---------- presentation ----------
class App <<routing>> {
  - route : landing, login, app
}
class PhysioPages <<physiotherapist screens>> {
  DashboardPage
  PatientsPage
  ApprovalsPage
  AtRiskPage
  ExercisesPage
}
class AdminPanels <<clinic admin screens>> {
  OverviewPanel
  PhysiotherapistsPanel
  ClinicProfilePanel
}
class Hooks <<React hooks>> {
  useAuth()
  usePatients()
  usePhysiotherapists()
}

' ---------- domain ----------
class PatientUseCases {
  + getAllPatients()
  + approvePatient(id)
  + setWarning(id, message)
}
class SessionUseCases {
  + getAllSessions()
  + getLatestEmgForPatient(id)
}
class ExerciseUseCases {
  + getAllExercises()
  + filterExercises(...)
}
class ExercisePlanUseCases {
  + getActivePlan(patientId)
  + assignSession(...)
}
class WearablePresenceUseCases {
  + getPresence()
  + subscribe(onChange)
}
class Patient <<entity>> {
  + name, injury, rom, trend
  + status, approved, baseline
  + isAtRisk() : bool
}
class Exercise <<entity>> {
  + name, target, difficulty
  + mediaUrl
  + matches(query) : bool
}

' ---------- infrastructure ----------
class ExerciseRepository {
  + getAll() : Exercise[]
}
class SupabaseClient <<Postgres, Auth, Realtime>> {
  used by every use case,
  repository and hook
}

' ---------- relationships ----------
App *-down- PhysioPages
App *-down- AdminPanels
App -down-> Hooks
AdminPanels -right-> Hooks

PhysioPages -down-> PatientUseCases
PhysioPages -down-> SessionUseCases
PhysioPages -down-> ExerciseUseCases
PhysioPages -down-> ExercisePlanUseCases
App -down-> WearablePresenceUseCases

PatientUseCases -right-> SessionUseCases
PatientUseCases .down.> Patient
ExerciseUseCases -down-> ExerciseRepository
ExerciseRepository .right.> Exercise
ExerciseRepository -down-> SupabaseClient

@enduml
