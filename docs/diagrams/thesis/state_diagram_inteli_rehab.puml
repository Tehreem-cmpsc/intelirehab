@startuml state_diagram_inteli_rehab
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype polyline
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2
skinparam nodesep 55
skinparam ranksep 55
skinparam roundCorner 18
skinparam state {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  ArrowColor Black
  StartColor Black
  EndColor Black
}
hide empty description

state "Launching" as Launching
state "Checking Account" as Checking
state "Signed Out" as SignedOut
state "Onboarding" as Onboarding
state "Pairing Band" as Pairing
state "Calibrating" as Calibrating
state "Awaiting Approval" as Awaiting
state "Band Connecting" as BandConnecting
state "Home Idle" as Home
state "Exercise Ready" as Ready
state "Session Running" as Running
state "Session Paused" as Paused
state "Saving Session" as Saving
state "Session Summary" as Summary
state "Syncing Sessions" as Syncing
state "Error" as Error

[*] --> Launching : appOpened()
Launching --> Checking : appReady()

Checking --> SignedOut : noSession()
SignedOut --> Checking : signedIn()
SignedOut --> Onboarding : getStarted()
Checking --> Onboarding : setupIncomplete()

Onboarding --> Pairing : accountCreated()
Pairing --> Calibrating : bandLinked()
Calibrating --> Awaiting : baselineSaved()
Awaiting --> BandConnecting : physioApproved()
Checking --> BandConnecting : approved()

BandConnecting --> Home : bandConnected()
Home --> BandConnecting : bandDropped()
Home --> SignedOut : signedOut()

Home --> Ready : exerciseChosen()
Ready --> Running : zeroSet()
Running --> Paused : pauseTriggered()
Paused --> Running : resumed()
Running --> Saving : sessionEnded()
Saving --> Summary : sessionSaved()
Summary --> Home : backToHome()

Home --> Syncing : pendingFound()
Syncing --> Home : synced()

Checking --> Error : lookupFailed()
BandConnecting --> Error : bandNotFound()
Syncing --> Error : connectionLost()
Error --> Checking : retry()
Error --> BandConnecting : reconnect()
Error --> Home : recovered()
@enduml
