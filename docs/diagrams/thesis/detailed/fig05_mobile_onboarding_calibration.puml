@startuml fig05_mobile_onboarding_calibration
title Figure 5: Mobile app - sign-up, routing and guided calibration
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #444444
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #F2F2F2
  BorderColor #777777
  FontColor #222222
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #222222
}
skinparam title {
  FontSize 15
}

class AuthGate <<screen>> {
  - resolve() : Widget
}
class AuthService {
  + onAuthStateChange : Stream<AuthState>
  + signIn(email, password)
  + signOut()
  + fetchMyPatientRow() : Map
  + fetchPairedDevice(patientId) : Map
}
class OnboardingFlow <<screen>> {
  + initialData : OnboardingData
  + initialStep : int
  - saveCurrentStep()
}
class OnboardingData {
  + patientId : String
  + deviceRecordId : String
  + clinic : Clinic
  + physio : Physiotherapist
  + wearable : WearableDevice
  + baseline : BaselineReading
  + baselineSaved : bool
  + musclesCalibrated : bool
  + band : ArmBandBleService
  + bandLinked : bool
  + releaseBand()
}
class WearableSetupStep <<screen>>
class CalibrationStep <<screen>> {
  + {static} reps : int = 3
  - phase : intro, sensors, neutral, movement,\n  muscle, check, muscleRetry, done
}
class BaselineRecorder {
  + reps : int
  + repsDetected : int
  + complete : bool
  + addNeutral(angle)
  + addMovement(angle)
  + result() : BaselineReading
}
class BaselineReading {
  + neutral : int
  + flexion : int
  + extension : int
  + range : int
}
class Clinic {
  + id : String
  + name : String
  + address : String
}
class Physiotherapist {
  + id : String
  + fullName : String
  + specialization : String
}
class WearableDevice {
  + id : String
  + name : String
  + macAddress : String
}
class OnboardingRepository {
  + {static} baselineMarker : String
  + createAccount(data) : SignUpResult
  + chooseClinicAndPhysio(clinic, physio)
  + saveWearable(patientId, device) : String
  + saveBaseline(patientId, deviceRecordId,\n  baseline, reps)
  + hasBaseline(patientId) : bool
  + hydrate(patientRow) : OnboardingData
}
enum SignUpResult <<enumeration>> {
  registered
  needsEmailConfirmation
}
class ArmBandBleService
class HomeShell <<screen>>
class WaitingForPhysioScreen <<screen>>

AuthGate --> AuthService
AuthGate --> OnboardingRepository : hasBaseline, hydrate
AuthGate ..> OnboardingFlow : <<navigate>>\nno baseline
AuthGate ..> WaitingForPhysioScreen : <<navigate>>\nawaiting approval
AuthGate ..> HomeShell : <<navigate>>\napproved
OnboardingFlow "1" *-- "1" OnboardingData
OnboardingFlow "1" *-- "1" CalibrationStep
OnboardingFlow "1" *-- "1" WearableSetupStep
OnboardingFlow --> OnboardingRepository
OnboardingData "1" *-- "1" ArmBandBleService : band
OnboardingData "1" o-- "0..1" Clinic
OnboardingData "1" o-- "0..1" Physiotherapist
OnboardingData "1" o-- "0..1" WearableDevice
OnboardingData "1" o-- "0..1" BaselineReading
CalibrationStep --> OnboardingData
CalibrationStep "1" *-- "1" BaselineRecorder
BaselineRecorder ..> BaselineReading : <<create>>
OnboardingRepository ..> SignUpResult

@enduml
