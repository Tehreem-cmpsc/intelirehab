@startuml fig02_domain_model
title Figure 2: Domain model (persistent classes and their associations)
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #444444
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #F2F2F2
  BorderColor #777777
  FontColor #222222
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #222222
}
skinparam title {
  FontSize 15
}

class Clinic {
  name : String
  email : String
  phone : String
  address : String
}
class Physiotherapist {
  physioCode : String
  fullName : String
  specialization : String
  licenseNumber : String
  yearsExperience : int
}
class Patient {
  name : String
  email : String
  dateOfBirth : Date
  gender : String
  injurySide : String
  approved : boolean
  wearableConnected : boolean
}
class Injury {
  affectedSide : String
  affectedJoint : String
  injuryType : String
  cause : String
  painLevel : int
  diagnosisDate : Date
}
class WearableDevice {
  serialNo : String
  macAddress : String
  firmwareVersion : String
  status : String
  isConnected : boolean
  lastSeenAt : DateTime
}
class RehabilitationPlan {
  planName : String
  startDate : Date
  endDate : Date
  status : String
  versionNo : int
}
class Exercise {
  name : String
  target : String
  difficulty : String
  description : String
  mediaUrl : String
}
class ExerciseAssignment {
  sets : int
  reps : int
  romTarget : int
  frequency : String
  active : boolean
}
class Session {
  performedAt : DateTime
  rom : int
  reps : int
  quality : int
  fatigue : int
  durationSeconds : int
}
class MovementAnalysis {
  jointAngle : float
  rom : float
  repetitionCount : int
  movementScore : float
  muscleActivation : String
  fatigueLevel : String
  postureStatus : String
  compensationDetected : boolean
}
class Alert {
  alertType : String
  severity : String
  message : String
  createdAt : DateTime
  acknowledgedAt : DateTime
}
class EmgReading {
  muscle : String
  value : int
}
class SensorReading {
  accX, accY, accZ : float
  gyroX, gyroY, gyroZ : float
}
class Badge {
  code : String
  name : String
  description : String
}
class PatientBadge {
  earnedAt : DateTime
}

Clinic "1" -- "0..*" Physiotherapist : employs
Clinic "0..1" -- "0..*" Patient : treats
Physiotherapist "0..1" -- "0..*" Patient : responsible for
Patient "1" *-- "0..*" Injury
Patient "1" *-- "0..*" WearableDevice : owns
Patient "1" *-- "0..*" RehabilitationPlan
Physiotherapist "0..1" -- "0..*" RehabilitationPlan : creates
Patient "1" *-- "0..*" ExerciseAssignment
Exercise "1" -- "0..*" ExerciseAssignment
RehabilitationPlan "0..1" o-- "0..*" ExerciseAssignment
Patient "1" *-- "0..*" Session
Exercise "0..1" -- "0..*" Session
WearableDevice "0..1" -- "0..*" Session : recorded with
Session "1" *-- "0..*" MovementAnalysis
Session "1" *-- "0..*" EmgReading
Session "1" *-- "0..*" SensorReading
Session "0..1" o-- "0..*" Alert
MovementAnalysis "0..1" -- "0..*" Alert : raises
Patient "1" -- "0..*" PatientBadge
Badge "1" -- "0..*" PatientBadge

note right of Physiotherapist
  A Physiotherapist also assigns each
  ExerciseAssignment (assignedBy) and
  acknowledges Alerts (acknowledgedBy).
end note

note bottom of Session
  A Session without an Exercise is the patient's
  sign-up calibration baseline; its MovementAnalysis
  has postureStatus = "baseline_calibration".
end note

@enduml
