@startuml fig09_mobile_digital_twin
title Figure 9: Mobile app - live 3D digital twin
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #444444
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #F2F2F2
  BorderColor #777777
  FontColor #222222
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #222222
}
skinparam title {
  FontSize 15
}

class ActiveSessionScreen <<screen>>
class LiveTwinView <<widget>> {
  + samples : Stream<ArmBandSample>
  + fallbackPercent : int
  + tier : SafetyTier
  + side : String
}
interface TwinController <<interface>> {
  + setElbow(degrees)
  + setTier(tier)
  + setEmg(biceps, triceps)
  + setSide(side)
}
class TwinBridge {
  + minInterval : Duration
  + isReady : bool
  + hasFailed : bool
  + onReady
  + onError
  + handleMessage(json)
}
class TwinAssetServer <<singleton>> {
  + pageUri(query) : Uri
  + {static} assetKeyFor(path) : String
  + close()
}
class "twin.js (Three.js scene)" as TwinPage <<WebView page>> {
  setElbow(deg)
  setTier(name)
  setEmg(biceps, triceps)
  setSide(side)
}
class "Arm_L / Arm_R .gltf" as ArmModel <<asset>>
class LiveDigitalTwin <<2D fallback>>
class ArmBandSample

ActiveSessionScreen *-- LiveTwinView
LiveTwinView "1" *-- "1" TwinBridge
LiveTwinView --> TwinAssetServer : loads the page
LiveTwinView ..> LiveDigitalTwin : shown until the model\nhas loaded, or on failure
LiveTwinView ..> ArmBandSample : <<consumes>>
TwinController <|.. TwinBridge
TwinBridge ..> TwinPage : JavaScript calls,\nthrottled to about 30 Hz
TwinPage ..> TwinBridge : ready, error messages
TwinPage ..> ArmModel : <<loads>>
TwinAssetServer ..> TwinPage : <<serves, 127.0.0.1>>
TwinAssetServer ..> ArmModel : <<serves>>

note bottom of TwinPage
  Skins the arm at the elbow, bends the forearm to the band's angle,
  tints the arm by safety tier, and paints the biceps with the
  muscle-activation colours.
end note

@enduml
