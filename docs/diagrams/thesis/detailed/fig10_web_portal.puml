@startuml fig10_web_portal
title Figure 10: Web portal - layered structure
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #444444
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #F2F2F2
  BorderColor #777777
  FontColor #222222
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #222222
}
skinparam title {
  FontSize 15
}

package "Presentation" {
  class App <<AppRoutes>> {
    - route : landing, login, app
  }
  class PhysioShell <<physiotherapist>>
  class PortalShell <<clinic admin>>
  class PhysioPages <<React components>> {
    DashboardPage
    PatientsPage
    ApprovalsPage
    AtRiskPage
    ExercisesPage
  }
  class AdminPanels <<React components>> {
    OverviewPanel
    PhysiotherapistsPanel
    PatientsPanel
    ClinicProfilePanel
  }
  class Hooks <<React hooks>> {
    useAuth()
    usePatients()
    usePhysiotherapists()
    useClinicProfile()
  }
}
package "Domain" {
  class Patient <<entity>> {
    + id, name, regId, injury
    + rom, trend, streak
    + status
    + approved
    + baseline
    + wearableLive
    + with(changes) : Patient
    + isAtRisk() : bool
    + isPendingApproval() : bool
  }
  class Exercise <<entity>> {
    + id, name, target, difficulty
    + desc, mediaUrl, mediaType
    + isDifficulty(level) : bool
    + matches(query) : bool
  }
  class PatientUseCases {
    + getAllPatients()
    + approvePatient(id)
    + setWarning(id, message)
    + removePatient(id)
  }
  class SessionUseCases {
    + getAllSessions()
    + getLatestEmgForPatient(patientId)
  }
  class ExerciseUseCases {
    + getAllExercises()
    + filterExercises(exercises, difficulty, query)
  }
  class ExercisePlanUseCases {
    + getActivePlan(patientId)
    + assignSession(...)
  }
  class WearablePresenceUseCases {
    + getPresence()
    + subscribe(onChange)
  }
}
package "Infrastructure" {
  class ExerciseRepository {
    + getAll() : Exercise[]
    + filter(exercises, difficulty, query)
  }
  class VisualizationService {
    + getRomColor(value)
    + getStatusMeta(status)
    + getDifficultyColor(level)
  }
  class SupabaseClient <<client>>
}
class SupabaseBackend <<Postgres, Auth, Realtime, Edge Functions>>

App *-- PhysioShell
App *-- PortalShell
App *-- PhysioPages
PortalShell *-- AdminPanels
App --> Hooks
AdminPanels --> Hooks
PhysioPages --> PatientUseCases
PhysioPages --> SessionUseCases
PhysioPages --> ExerciseUseCases
PhysioPages --> ExercisePlanUseCases
PhysioPages ..> VisualizationService
App --> WearablePresenceUseCases
PatientUseCases --> SessionUseCases
PatientUseCases ..> Patient : <<create>>
ExerciseUseCases --> ExerciseRepository
ExerciseRepository ..> Exercise : <<create>>
ExerciseRepository ..> SupabaseClient
SupabaseClient ..> SupabaseBackend : HTTPS

note bottom of SupabaseClient
  Every use case, repository and hook
  reads and writes through SupabaseClient.
end note

@enduml
