@startuml fig06_mobile_live_session
title Figure 6: Mobile app - live exercise session
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #444444
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #F2F2F2
  BorderColor #777777
  FontColor #222222
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #222222
}
skinparam title {
  FontSize 15
}

class ActiveSessionScreen <<screen>> {
  + exercise : AssignedExercise
  + armSide : String
}
interface SessionController <<interface>> {
  + repsTarget : int
  + romTargetPercent : int
  + isRunning : bool
  + awaitingUnsafeAck : bool
  + repsCompleted : int
  + liveAngle : int
  + activation : MuscleActivation
  + currentTier : SafetyTier
  + currentMessage : String
  + repHint : String
  + hasPendingCheck : bool
  + fatigueLevel : FatigueLevel
  + start()
  + pause()
  + resume()
  + acknowledgeUnsafe()
  + buildResult(exercise) : SessionResult
}
class LiveSession {
  + sessionId : String
  + analysisId : String
  + fullRangeDegrees : double
  + alerts : List<SessionAlert>
  + onSample(sample, now)
  + {static} activationOf(emgPct)
}
class SessionSimulator <<demo and tests>>
class AssignedExercise {
  + exerciseId : String
  + name : String
  + difficulty : String
  + sets : int
  + repsTarget : int
  + romTarget : int
}
class SessionResult {
  + id : String
  + startedAt : DateTime
  + repsCompleted : int
  + romAchieved : int
  + peakJointAngle : int
  + achievedRangeDegrees : int
  + peakActivation : MuscleActivation
  + duration : Duration
  + peakFatigue : FatigueLevel
  + worstTier : SafetyTier
}
class SessionAlert {
  + id : String
  + tier : SafetyTier
  + message : String
  + at : DateTime
}
enum SafetyTier <<enumeration>> {
  normal
  needsCorrection
  unsafe
}
enum MuscleActivation <<enumeration>> {
  resting
  light
  moderate
  high
}
enum FatigueLevel <<enumeration>> {
  normal
  mild
  moderate
  critical
}
class WearableConnectionController {
  + liveSamples : Stream<ArmBandSample>
}
class ArmBandSample {
  + elbowDeg : double
  + emg1Pct : double
}
class FatigueEstimator {
  + score : double
  + addRep(meanEmgPct, peakSpeedDegPerSec) : double
  + easeBack()
}

LiveSession "1" *-- "1" FatigueEstimator
ActiveSessionScreen --> SessionController
ActiveSessionScreen --> WearableConnectionController
ActiveSessionScreen --> AssignedExercise
SessionController <|.. LiveSession
SessionController <|.. SessionSimulator
LiveSession ..> ArmBandSample : <<consumes>>
WearableConnectionController ..> ArmBandSample : <<produces>>
SessionController ..> SessionResult : <<create>>
SessionResult "1" o-- "1" AssignedExercise
SessionResult "1" *-- "0..*" SessionAlert
SessionAlert --> SafetyTier
SessionResult --> SafetyTier : worstTier
SessionResult --> MuscleActivation
SessionResult --> FatigueLevel

@enduml
