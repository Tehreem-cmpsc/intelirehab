@startuml fig07_mobile_rep_assessment
title Figure 7: Mobile app - rep assessment: trained model (amber) and live safety rules (red)
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 0
skinparam dpi 200
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #222222
  ArrowColor #222222
  FontColor #000000
  StereotypeFontColor #444444
  AttributeFontSize 11
}
skinparam package {
  BackgroundColor #F2F2F2
  BorderColor #777777
  FontColor #222222
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #222222
}
skinparam title {
  FontSize 15
}

class LiveSession {
  + onSample(sample, now)
  + currentTier : SafetyTier
  + currentMessage : String
  + repHint : String
}
class ElbowRepChecker <<amber: after each rep>> {
  + mode : RepCheckMode
  + {static} cached : ElbowRepChecker
  + {static} preload()
  + threshold : double
  + check(samples : List<RepSample>) : RepCheck
  + {static} resample(samples, n) : List<double>
}
enum RepCheckMode <<enumeration>> {
  gentle
  balanced
}
class RepSample {
  + t : double
  + angle : double
}
class RepCheck {
  + score : double
  + threshold : double
  + durationSeconds : double
  + angle : List<double>
  + rebuilt : List<double>
  + message : String
  + hint : String
  + ok : bool
}
class ElbowAutoencoder <<trained model>> {
  + steps : int = 100
  + withDuration : bool
  + mean, std : List<double>
  + thresholdGentle : double
  + thresholdBalanced : double
  + tolerance : List<double>
  + healthyDuration : Range
  + {static} fromJson(source) : ElbowAutoencoder
  + score(angle, durationSeconds) : ElbowScore
}
class ElbowScore {
  + score : double
  + rebuiltDegrees : List<double>
}
class "elbow_autoencoder.json" as ModelFile <<asset>> {
  weights, mean, std,
  thresholds, tolerance
}
class SafetyMonitor <<red: live, every sample>> {
  + limits : SafetyLimits
  + update(angle, speed, now) : SafetyViolation
  + reset()
}
class SafetyLimits {
  + maxAngleDeg : double
  + maxSpeedDegPerSec : double
  + hold : Duration
}
enum SafetyViolation <<enumeration>> {
  angle
  speed
}
class RepAssessor <<fallback rules>> {
  + {static} unsafeSpeedDegPerSec : double
  + {static} fastSpeedDegPerSec : double
  + {static} shortReach : double
  + assess(metrics, now) : RepAssessment
}
class RepMetrics {
  + peakDegrees : double
  + targetDegrees : double
  + peakSpeedDegPerSec : double
  + duration : Duration
  + reach : double
}
LiveSession "1" o-- "0..1" ElbowRepChecker : model loaded
LiveSession "1" *-- "1" SafetyMonitor
LiveSession "1" o-- "1" RepAssessor : used when no model
ElbowRepChecker "1" *-- "1" ElbowAutoencoder
ElbowRepChecker --> RepCheckMode
ElbowRepChecker ..> RepSample : <<use>>
ElbowRepChecker ..> RepCheck : <<create>>
ElbowAutoencoder ..> ElbowScore : <<create>>
ElbowAutoencoder ..> ModelFile : <<loads weights>>
SafetyMonitor "1" o-- "1" SafetyLimits
SafetyMonitor ..> SafetyViolation : <<create>>
RepAssessor ..> RepMetrics : <<use>>

note bottom of ModelFile
  Produced from elbow_final.pt by the AI pipeline
  (export_to_app.py). A test checks the Dart network
  against PyTorch on 14 reference reps.
end note
note right of SafetyLimits
  Placeholder limits; to be set
  by a physiotherapist.
end note

@enduml
