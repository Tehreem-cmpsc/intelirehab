@startuml Intelli_Rehab_Class_Diagram_Short
' Condensed class diagram: the main classes only, with their real names from
' the source. The full version is Intelli_Rehab_Class_Diagram_current.puml.
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F5F8F7
  BorderColor #0D6E76
  ArrowColor #073C41
}
skinparam package {
  BorderColor #0D6E76
}

package "Band firmware (C++)" {
  class ArmbandSketch <<ArmEMG_IMU.ino>> {
    +loop() 500 Hz
    +handleCommand(g, z, m, i)
  }
  class MPU6500 {
    +read()
    +calibrateGyroBias()
  }
  class MadgwickAHRS {
    +updateIMU()
    +getQuaternion()
  }
  class EMGProcessor {
    +getPercentMVC()
    +startMVCCalibration()
  }
  class BLEStreamer {
    +sendData(elbowDeg, emg1Pct)
    +readCommand()
  }
}

package "Mobile app (Flutter)" {
  class AuthGate <<routing>> {
    -resolve()
  }
  class HomeShell
  class OnboardingFlow
  class CalibrationStep {
    sensors, zero pose,
    movement, muscle
  }
  class OnboardingData {
    +baseline
    +band
  }
  class BaselineRecorder {
    +addNeutral()
    +addMovement()
    +result()
  }
  class OnboardingRepository {
    +saveBaseline()
    +hasBaseline()
    +hydrate()
  }
  class ArmBandBleService {
    +samples : Stream
    +connect()
    +sendCommand()
  }
  class ArmBandSample {
    +elbowDeg
    +emg1Pct
  }
  class WearableConnectionController {
    +state
    +reconnect()
    +liveSamples
  }
  class ActiveSessionScreen
  interface SessionController {
    +start()
    +pause()
    +buildResult()
  }
  class LiveSession {
    +onSample()
  }
  class SessionSimulator
  class RepAssessor {
    +assess()
  }
  class FatigueEstimator
  class SessionResult
  class AssignedExercise
  class ExercisesRepository {
    +loadPlan()
    +saveSession()
  }
  class SessionJournal <<offline queue>> {
    +enqueue()
    +syncPending()
  }
  class LiveTwinView
  class TwinBridge
  class HomeRepository
}

package "Web portal (React)" {
  class App
  class Patient <<entity>>
  class Exercise <<entity>>
  class PatientUseCases
  class SessionUseCases
  class ExercisePlanUseCases
  class ExerciseUseCases
  class WearablePresenceUseCases
  class ExerciseRepository
}

class Supabase <<backend>> {
  Postgres + RLS
  Auth
  Realtime
  Edge Functions
}

' ---- firmware ----
ArmbandSketch *-- "2" MPU6500
ArmbandSketch *-- "2" MadgwickAHRS
ArmbandSketch *-- EMGProcessor
ArmbandSketch --> BLEStreamer
BLEStreamer ..> ArmBandBleService : BLE link

' ---- mobile ----
ArmBandBleService ..> ArmBandSample
WearableConnectionController *-- ArmBandBleService
WearableConnectionController --> OnboardingRepository
AuthGate --> OnboardingRepository
AuthGate ..> HomeShell
AuthGate ..> OnboardingFlow
HomeShell *-- WearableConnectionController
HomeShell --> SessionJournal
HomeShell --> HomeRepository
OnboardingFlow *-- OnboardingData
OnboardingFlow *-- CalibrationStep
OnboardingFlow --> OnboardingRepository
OnboardingData *-- ArmBandBleService
CalibrationStep *-- BaselineRecorder
CalibrationStep --> OnboardingData
ActiveSessionScreen --> SessionController
ActiveSessionScreen --> WearableConnectionController
ActiveSessionScreen --> ExercisesRepository
ActiveSessionScreen --> SessionJournal
ActiveSessionScreen *-- LiveTwinView
LiveTwinView *-- TwinBridge
SessionController <|.. LiveSession
SessionController <|.. SessionSimulator
LiveSession o-- RepAssessor
LiveSession o-- FatigueEstimator
LiveSession ..> ArmBandSample
SessionController ..> SessionResult
SessionResult o-- AssignedExercise
ExercisesRepository ..> AssignedExercise
SessionJournal ..> ExercisesRepository

' ---- web ----
App --> PatientUseCases
App --> WearablePresenceUseCases
App --> ExerciseUseCases
App --> ExercisePlanUseCases
PatientUseCases --> SessionUseCases
PatientUseCases ..> Patient
ExerciseUseCases --> ExerciseRepository
ExerciseRepository ..> Exercise

' ---- backend ----
OnboardingRepository ..> Supabase
ExercisesRepository ..> Supabase
HomeRepository ..> Supabase
PatientUseCases ..> Supabase
SessionUseCases ..> Supabase
ExercisePlanUseCases ..> Supabase
WearablePresenceUseCases ..> Supabase
ExerciseRepository ..> Supabase

note bottom of RepAssessor
  Rule-based safety check used by live sessions.
  The trained AI model does not exist yet.
end note
@enduml
